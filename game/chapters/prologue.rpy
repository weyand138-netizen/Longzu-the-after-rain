default resource_service_exit = False
default event_shared_cost_promised = False
default event_note_preserved_by_erii = False


label prologue_start:
    $ current_chapter = "prologue"
    scene bg rain_platform
    with dissolve_slow

    narrator "雨把站台上的灯切成许多段。每一段都落在积水里，像一条走不通的路。"
    narrator "路明非把湿透的车票攥在掌心。广播正在报下一班车，身后的人群却没有谁真的在等车。"
    narrator "绘梨衣没有催他，只是轻轻拉住他的袖口。"
    narrator "她低头看着脚边，一张被雨打湿的纸贴在排水沟旁。"
    narrator "雨水从站棚边缘一滴一滴落下，打在纸面已经散开的墨迹上。路明非先看见那些空白，再看见仍能辨认的几笔。"
    narrator "人群向检票口挪动时，没人注意他们停在排水沟旁。广播重复了一遍车次，像是在催促一个早就应该作出的决定。"
    narrator "路明非把车票翻过来，背面只有售票机留下的浅色条纹。那张纸却比车票更像一件必须先处理的东西。"
    narrator "绘梨衣的袖口被雨打湿了一圈。她没有去擦，只把目光留在纸上，像是等他先承认那几行字确实属于她。"

    menu:
        "先读那张被雨打湿的纸":
            $ apply_choice("prologue_read_note", {"understanding": 1})
            narrator "纸上没有求救，也没有路线。只有七件小事，字迹被水晕开了一半。"
            narrator "最下面一行还能认出来：想在没有人认识我们的地方，玩一整晚游戏。"
            lm "这是你写的？"
            erii "嗯。"
            narrator "她点过头，又用指尖按住纸上几行没有完成的空白。"
            narrator "那张纸像是愿望，也像是她自己。"
            narrator "路明非没有急着把纸拿近。水迹把日期和地点冲成模糊的一团，剩下的字却都指向一些很小的事情。"
            narrator "他看见一枚游戏币、一盏不必整夜亮着的灯，还有一行被她反复描过的字。每一件都没有说明该由谁决定。"
            narrator "绘梨衣用指尖沿着空白划了一下，又把手收回。她没有解释那几件小事，像是在提醒他不要替空白写上答案。"

        "先催她上车，离开这里再说":
            $ apply_choice("prologue_hurry_to_train", {})
            lm "先走。等安全了，我们再看。"
            narrator "绘梨衣点头，却弯腰把那张纸捡了起来。她把它折得很小，藏进袖口。"
            $ event_note_preserved_by_erii = True
            narrator "路明非忽然意识到，“以后”可能不是一个可以随便使用的词。"
            narrator "她折纸的动作很慢，先把湿掉的边角压平，再把没有写完的部分藏到里面。路明非伸出的手停在半空，没有把纸抢回来。"
            narrator "列车的提示音响了两次。她把袖口按紧，确认纸还在，才跟着人群往前走。那一点确认没有变成一句解释，却留下了清楚的方向。"

    narrator "列车进站的风从隧道里涌出来。绘梨衣抬头望着线路图，像在看一张没有图例的地图。"
    narrator "线路图上的颜色被站台灯切断，几条线在同一个小圆点前交叠。路明非知道自己可以马上报出一条最快的路线，却不知道那是不是她要的地方。"
    narrator "绘梨衣把手从袖口移到地图边缘，沿着一条不显眼的支线慢慢往前。她看了看车次，又看了看他，没有把手指停在任何一个终点。"
    narrator "广播里的人声被车轮的摩擦盖住。路明非把想说的“随便”咽了回去，改为等她把那条线看完。"

    menu:
        "问她想去哪里":
            $ apply_choice("prologue_ask_destination", {})
            lm "你来选。今天先去哪？"
            narrator "她的手停在线路图前，回头看他，像在确认这不是另一道命令。"
            lm "真的。选错了就再换一班。"
            narrator "她看了很久，手指最终停在一座并不起眼的小站上，没有再移开。"

            menu:
                "照她选的小站走，即使要多绕一小时":
                    $ apply_choice("prologue_accept_destination", {"autonomy": 1})
                    $ grant_local_achievement("CHOICE_ASK_FIRST")
                    lm "就去那里。慢一点也没关系。"
                    narrator "绘梨衣把手指留在线路图上，直到他也看清换乘的方向，才轻轻点头。"
                    narrator "她先确认第一段车次，再把第二段换乘的站名抄在愿望纸背面。笔尖停顿了一下，像是在给自己留下可以回头核对的地方。"
                    narrator "路明非把车票塞进外套内袋，没有把线路图折走。她仍用手指压住那个小站，直到检票提示响起。"

                "还是改走更快的东线":
                    $ apply_choice("prologue_override_destination", {})
                    lm "先走东线。等安全了，再去你选的地方。"
                    narrator "她收回手，线路图上那座小站重新变成了一个没有被回答的名字。"
                    narrator "她没有争辩，只把手指移到东线的换乘点。那一小段移动让地图重新恢复成一张可以执行的路线，却没有抹掉刚才被她指过的站名。"
                    narrator "路明非听见自己说“等安全了”，也听见这句话把她的选择推到了一个没有日期的以后。"

        "替她选最快离开市区的路线":
            $ apply_choice("prologue_choose_route", {})
            lm "走东线。换乘少，也更难被堵住。"
            narrator "她立刻点头。太快了，快得让这个动作更像服从而不是选择。"
            narrator "她的手还停在地图下方，没有去碰东线的标记。车次信息一条条亮起，路线因此显得合理，却没有因此变成她亲手选出的东西。"
            narrator "路明非把最快的换乘时间记在脑中，随后才发现她一直看着站棚外的出口。她记住的也许不是东线，而是离开时能看见什么。"

    scene bg ticket_gate
    with dissolve

    narrator "检票口前有三件不对劲的东西。坏掉的监控灯、贴着封条的维修门，还有一个从不看时刻表的男人。"
    narrator "广播开始倒数。路明非只能把其中一件事牢牢记住。"
    narrator "坏掉的监控灯每隔几秒闪一下，把男人的影子切成两段。封条边缘没有积灰，维修门却像很久没人真正打开过。"
    narrator "绘梨衣站在检票闸机旁，鞋尖避开一小片红泥。她没有看那个男人，只把视线在灯、门和鞋印之间来回了一次。"
    narrator "路明非摸到口袋里的车票，纸张被掌心的湿气弄软。广播倒数到最后三声时，三件东西仍然都在原来的位置。"
    narrator "他明白自己不能把所有细节都变成命令。能留下哪一件，应该成为他们接下来真正携带的东西。"

    menu:
        "记住维修门的位置":
            $ apply_choice("prologue_notice_service_exit", {"preparation": 1})
            narrator "封条是新的，锁却很旧。真要逃的时候，那里或许比站台更可靠。"
            $ resource_service_exit = True
            narrator "绘梨衣走到维修门旁，没有碰锁，只用鞋尖量了一下门缝到墙角的距离。她回头看他，确认这个位置已经被两个人同时记住。"
            narrator "路明非把维修门的编号写在车票背面。她看了一眼，没有把票拿走；这一次，记号被留在了他们都能找到的地方。"

        "对照红泥，并把追踪方向指给她看":
            $ apply_choice("prologue_notice_tracker", {"truth": 1})
            narrator "东京连下三天雨，市区没有这种干燥的红泥。路明非又看了一眼站台边缘同色的鞋印：那个人从东侧入口一路跟来。"
            lm "红泥从东边延到这里。他不是临时发现我们的，也知道我们往哪边走。"
            narrator "绘梨衣顺着他指的方向看过去，又把两根手指并在一起，朝相反方向轻轻一推。"
            lm "嗯。换方向，但不瞒你。"
            narrator "她的手指停在相反方向，随后又指向自己的耳朵。广播里车次更换的提示被重复了一遍，她像是在确认两件事不能只靠他的判断。"
            narrator "路明非把红泥的位置、男人的入口和下一班车的时间在心里排成一列，没有把其中任何一项说成已经解决。"

        "告诉绘梨衣：如果出事，我们一起决定":
            $ apply_choice("prologue_promise_cost", {})
            lm "如果他们追上来，你不用听我的命令。我们一起决定。后果也一起担。"
            narrator "绘梨衣把他的手翻过来，将自己的手掌覆在上面。"
            $ event_shared_cost_promised = True
            erii "嗯。"
            narrator "她的掌心很凉，覆上来以后却没有立刻移开。路明非看见她先看自己的手，再看向封条和检票口之间那条狭窄的通道。"
            narrator "这个承诺没有让追踪者消失，也没有让下一班车变得更安全。它只让两个人都知道，接下来不能把后果藏在一句“我来处理”后面。"

    scene bg train_window
    with dissolve_slow

    narrator "车门关闭。东京被雨推向玻璃另一侧。"
    narrator "绘梨衣把那张纸摊在膝上，用指甲慢慢压平折痕。"
    narrator "她向路明非展开七根手指，又指了指窗外飞快退后的站台。"
    narrator "车厢里很安静，只有雨刷掠过车窗时留下短暂的白线。她把刚才写在车票背面的路线抄到愿望纸角落，写完又把那一角折回去。"
    narrator "路明非看见她把维修门、红泥和东线分别画成三个小记号。它们彼此没有连成答案，却都变成了以后可以再次核对的事实。"
    narrator "列车驶出站棚后，站台上的人影被一根根电线杆切开。绘梨衣没有回头，只把袖口里那张纸移到更干燥的地方。"
    lm "你问七天够不够？"
    narrator "她点头。"
    lm "不知道。"
    narrator "这一次，他没有把不知道说成没问题。"
    lm "但第一天从现在开始。"
    narrator "绘梨衣把七根手指收回，只留下拇指压住纸面。她没有要求他保证七天会发生什么，只把第一件仍然可以做的事指给他看。"
    narrator "路明非把那张纸看了一遍，没有替她补上最后几件小事。列车继续向前，雨声逐渐变成车轮下面稳定的回响。"

    $ unlock_memory("PROLOGUE")
    $ renpy.save_persistent()

    call screen chapter_complete(
        "序章完成",
        "有些选择不会立刻告诉你答案。它们会在之后重新出现。",
    )
    return
